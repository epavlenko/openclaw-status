{
  "name": "openclaw-status",
  "version": "0.1.0",
  "description": "OpenClaw plugin for Status App communities — send/receive messages via Waku protocol",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "openclaw": {
    "extensions": ["./src/index.ts"]
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "bash test/e2e-tool.sh",
    "test:smoke": "bash test/smoke.sh",
    "lint": "tsc --noEmit"
  },
  "keywords": [
    "openclaw",
    "status",
    "waku",
    "web3",
    "messaging",
    "community"
  ],
  "license": "MIT",
  "dependencies": {},
  "devDependencies": {
    "typescript": "^5.7.0",
    "vitest": "^3.0.0",
    "@types/node": "^22.0.0"
  }
}
